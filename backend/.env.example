# --- LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Vector store (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- API authentication ---
# Shared secret required via the X-API-Key header on /upload, /ask,
# /clear, and DELETE /documents. Leave empty for local dev (localhost) —
# auth is then disabled with a warning logged at startup. MUST be set
# before this API is reachable outside your own machine (see
# kubernetes/backend-auth-secret.yaml.example).
API_KEY=

# --- App ---
LOG_LEVEL=INFO
